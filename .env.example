PARASAIL_API_KEY=""       # Parasail hackathon day-pass key
DISCORD_WEBHOOK_URL=""    # venue webhook from the event guide
TEAM=""                   # team handle from your welcome card, e.g. team-04
TEAM_TOKEN=""             # only if your card has one
SCENARIO_MCP="https://api.you.com/mcp/halloween-hack-26"   # the welcome card wins if it differs
